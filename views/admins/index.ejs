<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
  <div>
    <h4 class="fw-bold text-black mb-1"><i class="fa-solid fa-users-gear text-info me-2"></i>Administrator Management</h4>
    <p class="text-secondary small mb-0">Authorize volunteer admins, monitor collection performance, and manage credentials</p>
  </div>
  <button class="btn btn-primary btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#createAdminModal">
    <i class="fa-solid fa-user-plus me-1"></i> Add Administrator
  </button>
</div>

<!-- Admin Activity Table -->
<div class="cse-table-wrapper">
  <div class="table-responsive">
    <table class="cse-table">
      <thead>
        <tr>
          <th>Administrator</th>
          <th>Role</th>
          <th>Account Status</th>
          <th>Contributions Collected</th>
          <th>Total Collected</th>
          <th>Expenses Submitted</th>
          <th>Last Login</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (admins && admins.length > 0) { %>
          <% admins.forEach(admin => { %>
            <% const stat = statsMap[admin._id.toString()] || { totalCollected: 0, contributionsCount: 0, expensesCount: 0 }; %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="bg-dark text-info border border-secondary border-opacity-50 rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.8rem;">
                    <%= admin.name.charAt(0).toUpperCase() %>
                  </div>
                  <div>
                    <span class="fw-semibold text-black d-block"><%= admin.name %></span>
                    <span class="text-secondary small" style="font-size: 0.72rem;"><%= admin.email %></span>
                  </div>
                </div>
              </td>
              <td>
                <span class="badge <%= admin.role === 'superadmin' ? 'bg-danger' : 'bg-primary' %> text-uppercase" style="font-size: 0.7rem;">
                  <%= admin.role %>
                </span>
              </td>
              <td>
                <% if (admin.isActive) { %>
                  <span class="badge-cse paid"><i class="fa-solid fa-circle-check me-1"></i>Active</span>
                <% } else { %>
                  <span class="badge-cse rejected"><i class="fa-solid fa-ban me-1"></i>Disabled</span>
                <% } %>
              </td>
              <td class="fw-bold text-black"><%= stat.contributionsCount %> tx</td>
              <td class="fw-bold text-success">₹<%= stat.totalCollected.toLocaleString('en-IN') %></td>
              <td class="text-secondary small"><%= stat.expensesCount %> bills</td>
              <td class="text-secondary small font-monospace">
                <%= admin.lastLogin ? new Date(admin.lastLogin).toLocaleDateString('en-IN') : 'Never' %>
              </td>
              <td>
                <% if (admin.role !== 'superadmin') { %>
                  <div class="d-flex gap-1">
                    <!-- Toggle Status -->
                    <form action="/admins/<%= admin._id %>/toggle-status" method="POST" class="d-inline">
                      <button type="submit" class="btn <%= admin.isActive ? 'btn-outline-warning' : 'btn-outline-success' %> btn-sm py-0 px-2" style="font-size: 0.75rem;" title="<%= admin.isActive ? 'Disable Access' : 'Enable Access' %>">
                        <i class="fa-solid <%= admin.isActive ? 'fa-user-slash' : 'fa-user-check' %>"></i>
                      </button>
                    </form>

                    <!-- Reset Password Modal Trigger -->
                    <button type="button" class="btn btn-outline-info btn-sm py-0 px-2" style="font-size: 0.75rem;" title="Reset Password" data-bs-toggle="modal" data-bs-target="#resetPasswordModal_<%= admin._id %>">
                      <i class="fa-solid fa-key"></i>
                    </button>
                  </div>

                  <!-- Reset Password Modal -->
                  <div class="modal fade" id="resetPasswordModal_<%= admin._id %>" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content bg-dark border-secondary">
                        <form action="/admins/<%= admin._id %>/reset-password" method="POST">
                          <div class="modal-header border-secondary">
                            <h6 class="modal-title text-light"><i class="fa-solid fa-key text-warning me-2"></i>Reset Password for <%= admin.name %></h6>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                          </div>
                          <div class="modal-body">
                            <div class="mb-3">
                              <label class="form-label small text-secondary">New Password (min 6 characters) *</label>
                              <input type="password" name="newPassword" class="form-control cse-input" placeholder="••••••••" minlength="6" required>
                            </div>
                          </div>
                          <div class="modal-footer border-secondary">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary btn-sm">Update Password</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                <% } else { %>
                  <span class="badge bg-dark border border-secondary text-secondary" style="font-size: 0.65rem;">Primary SuperAdmin</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Create Admin Modal -->
<div class="modal fade" id="createAdminModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark border-secondary shadow-lg">
      <form action="/admins" method="POST">
        <div class="modal-header border-secondary">
          <h5 class="modal-title text-light"><i class="fa-solid fa-user-shield text-info me-2"></i>Create Volunteer Administrator</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body text-light">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label small text-secondary fw-semibold">Volunteer Full Name *</label>
              <input type="text" name="name" class="form-control cse-input" placeholder="e.g. Priya Sharma" required>
            </div>

            <div class="col-12">
              <label class="form-label small text-secondary fw-semibold">Email Address *</label>
              <input type="email" name="email" class="form-control cse-input" placeholder="priya@cse.edu" required>
            </div>

            <div class="col-12">
              <label class="form-label small text-secondary fw-semibold">Initial Password *</label>
              <input type="password" name="password" class="form-control cse-input" placeholder="Minimum 6 characters" minlength="6" required>
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label small text-secondary fw-semibold">Phone</label>
              <input type="tel" name="phone" class="form-control cse-input" placeholder="9876543210">
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label small text-secondary fw-semibold">Department</label>
              <input type="text" name="department" class="form-control cse-input" value="Computer Science & Engineering">
            </div>
          </div>

          <div class="mt-3 p-2 rounded bg-black border border-secondary border-opacity-25 small text-secondary">
            <i class="fa-solid fa-lock text-success me-1"></i> Security: Role is locked to <strong>Admin Volunteer</strong>.
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary fw-semibold px-4">Create Admin Account</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="page-header d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3 mb-4">
  <div>
    <h4 class="page-title mb-1"><i class="fa-solid fa-chalkboard-user me-2 text-warning"></i>Teacher Directory</h4>
    <p class="page-subtitle mb-0">Invitation cards generated for respected faculty members — <%= invitations.length %> total</p>
  </div>
  <a href="/invitations/create" class="btn btn-warning btn-sm fw-semibold">
    <i class="fa-solid fa-wand-magic-sparkles me-1"></i>Add Teacher Invitation
  </a>
</div>

<!-- Flash message -->
<% if (typeof query !== 'undefined' && query.msg) { %>
  <div class="alert alert-success alert-dismissible fade show py-2 small mb-3" role="alert">
    <i class="fa-solid fa-circle-check me-2"></i><%= query.msg %>
    <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (invitations && invitations.length > 0) { %>

  <!-- Mobile Card View -->
  <div class="d-md-none">
    <% invitations.forEach(inv => { %>
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="avatar-circle avatar-warning">
              <%= inv.teacherName.charAt(0).toUpperCase() %>
            </div>
            <div class="flex-grow-1 min-w-0">
              <div class="fw-bold text-dark text-truncate"><%= inv.teacherName %></div>
              <div class="text-muted small text-truncate"><%= inv.designation %></div>
            </div>
            <span class="badge bg-warning-subtle text-warning border border-warning-subtle small">
              <%= inv.theme || 'cyber-gold' %>
            </span>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <div class="text-muted small">Department</div>
              <div class="small fw-semibold text-truncate"><%= inv.department %></div>
            </div>
            <div class="col-6">
              <div class="text-muted small">Event Date</div>
              <div class="small fw-semibold"><%= inv.eventDate %></div>
            </div>
            <div class="col-12">
              <div class="text-muted small">Joke / Quote</div>
              <div class="small fst-italic text-truncate"><%= inv.joke || '—' %></div>
            </div>
          </div>

          <div class="d-flex gap-2">
            <a href="/invitations/<%= inv._id %>/preview" class="btn btn-outline-primary btn-sm flex-grow-1">
              <i class="fa-solid fa-eye me-1"></i>Preview
            </a>
            <a href="/invitations/<%= inv._id %>/pdf" target="_blank" class="btn btn-warning btn-sm flex-grow-1">
              <i class="fa-solid fa-file-pdf me-1"></i>PDF
            </a>
            <form action="/invitations/<%= inv._id %>?_method=DELETE" method="POST" class="d-inline"
              onsubmit="return confirm('Delete invitation for <%= inv.teacherName %>?')">
              <button type="submit" class="btn btn-outline-danger btn-sm">
                <i class="fa-solid fa-trash"></i>
              </button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Desktop Table View -->
  <div class="card border-0 shadow-sm d-none d-md-block">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light border-bottom">
          <tr>
            <th class="fw-semibold text-muted small text-uppercase ps-4">Teacher</th>
            <th class="fw-semibold text-muted small text-uppercase">Department</th>
            <th class="fw-semibold text-muted small text-uppercase">Event</th>
            <th class="fw-semibold text-muted small text-uppercase">Theme</th>
            <th class="fw-semibold text-muted small text-uppercase">Added By</th>
            <th class="fw-semibold text-muted small text-uppercase pe-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% invitations.forEach(inv => { %>
            <tr>
              <td class="ps-4">
                <div class="d-flex align-items-center gap-3">
                  <div class="avatar-circle avatar-warning">
                    <%= inv.teacherName.charAt(0).toUpperCase() %>
                  </div>
                  <div>
                    <div class="fw-semibold text-dark"><%= inv.teacherName %></div>
                    <div class="text-muted small"><%= inv.designation %></div>
                  </div>
                </div>
              </td>
              <td class="text-muted small"><%= inv.department %></td>
              <td>
                <div class="small fw-semibold"><%= inv.eventDate %></div>
                <div class="text-muted small"><%= inv.eventTime %></div>
              </td>
              <td>
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle fw-normal">
                  <%= inv.theme %>
                </span>
              </td>
              <td>
                <% if (inv.createdBy) { %>
                  <div class="d-flex align-items-center gap-2">
                    <div class="avatar-circle avatar-sm avatar-primary"><%= inv.createdBy.name.charAt(0).toUpperCase() %></div>
                    <span class="small fw-semibold text-primary"><%= inv.createdBy.name %></span>
                  </div>
                <% } else { %>
                  <span class="text-muted small">—</span>
                <% } %>
              </td>
              <td class="pe-4">
                <div class="d-flex align-items-center gap-1">
                  <a href="/invitations/<%= inv._id %>/preview" class="btn btn-outline-primary btn-sm" title="Preview Card">
                    <i class="fa-solid fa-eye me-1"></i>Preview
                  </a>
                  <a href="/invitations/<%= inv._id %>/pdf" target="_blank" class="btn btn-warning btn-sm" title="Download PDF">
                    <i class="fa-solid fa-file-pdf me-1"></i>PDF
                  </a>
                  <form action="/invitations/<%= inv._id %>?_method=DELETE" method="POST" class="d-inline"
                    onsubmit="return confirm('Delete invitation for <%= inv.teacherName %>?')">
                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

<% } else { %>
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
      <i class="fa-solid fa-chalkboard-user fa-3x text-muted mb-3 opacity-50"></i>
      <h5 class="text-muted">No teacher invitations yet</h5>
      <p class="text-muted small mb-4">Create personalized invitation cards for respected faculty members.</p>
      <a href="/invitations/create" class="btn btn-warning fw-semibold">
        <i class="fa-solid fa-wand-magic-sparkles me-1"></i>Add First Invitation
      </a>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>

<% if (typeof successMsg !== 'undefined' && successMsg) { %>
  <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4 bg-success bg-opacity-10 border-success text-success" role="alert">
    <i class="fa-solid fa-circle-check me-2"></i>
    <div><%= successMsg %></div>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
  <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4 bg-danger bg-opacity-10 border-danger text-danger" role="alert">
    <i class="fa-solid fa-circle-exclamation me-2"></i>
    <div><%= errorMsg %></div>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
  <div>
    <h4 class="fw-bold text-black mb-1"><%= student.name %></h4>
    <p class="text-secondary small mb-0">Student Profile & Contribution Timeline</p>
  </div>
  <div class="d-flex gap-2">
    <% if (student.year !== '1st Year') { %>
      <a href="/contributions/collect?studentId=<%= student._id %>" class="btn btn-warning btn-sm fw-semibold">
        <i class="fa-solid fa-hand-holding-dollar me-1"></i> Collect Money
      </a>
    <% } %>
    <a href="/students" class="btn btn-outline-secondary btn-sm">
      <i class="fa-solid fa-arrow-left me-1"></i> Back
    </a>
  </div>
</div>

<div class="row g-4">
  <!-- Student Metadata Card -->
  <div class="col-12 col-lg-4">
    <div class="cse-card p-4">
      <div class="text-center mb-3">
        <div class="bg-dark text-primary border border-secondary border-opacity-50 rounded-circle d-inline-flex align-items-center justify-content-center fw-bold mb-2 shadow" style="width: 64px; height: 64px; font-size: 1.5rem;">
          <%= student.name.charAt(0).toUpperCase() %>
        </div>
        <h5 class="fw-bold text-black mb-0"><%= student.name %></h5>
        <span class="code-tag mt-1 d-inline-block"><%= student.rollNumber %></span>
      </div>

      <ul class="list-group list-group-flush bg-transparent">
        <li class="list-group-item bg-transparent text-light border-secondary border-opacity-25 d-flex justify-content-between px-0 py-2">
          <span class="text-secondary small">Academic Year:</span>
          <span class="badge <%= student.year === '1st Year' ? 'bg-danger' : 'bg-primary' %>"><%= student.year %></span>
        </li>
        <li class="list-group-item bg-transparent text-light border-secondary border-opacity-25 d-flex justify-content-between px-0 py-2">
          <span class="text-secondary small">Registration No:</span>
          <span class="small text-black font-monospace"><%= student.registrationNumber %></span>
        </li>
        <li class="list-group-item bg-transparent text-light border-secondary border-opacity-25 d-flex justify-content-between px-0 py-2">
          <span class="text-secondary small">Section / Semester:</span>
          <span class="small text-black"><%= student.section || 'A' %> / Sem <%= student.semester || '-' %></span>
        </li>
        <li class="list-group-item bg-transparent text-light border-secondary border-opacity-25 d-flex justify-content-between px-0 py-2">
          <span class="text-secondary small">Department:</span>
          <span class="small text-black"><%= student.department %></span>
        </li>
        <li class="list-group-item bg-transparent text-light border-secondary border-opacity-25 d-flex justify-content-between px-0 py-2">
          <span class="text-secondary small">Contribution Status:</span>
          <span class="badge-cse <%= student.year === '1st Year' ? 'not-eligible' : student.contributionStatus === 'Paid' ? 'paid' : 'pending' %>">
            <%= student.contributionStatus %>
          </span>
        </li>
        <li class="list-group-item bg-transparent text-light border-secondary border-opacity-25 d-flex justify-content-between px-0 py-2">
          <span class="text-secondary small">Total Contributed:</span>
          <span class="fw-bold text-success">₹<%= (student.totalContributed || 0).toLocaleString('en-IN') %></span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Contribution History Timeline -->
  <div class="col-12 col-lg-8">
    <div class="cse-card h-100">
      <div class="cse-card-header">
        <h6 class="fw-bold text-black mb-0"><i class="fa-solid fa-receipt text-primary me-2"></i>Contribution Transactions</h6>
        <span class="badge bg-dark border border-secondary text-secondary"><%= contributions.length %> recorded</span>
      </div>

      <div class="p-3">
        <% if (contributions && contributions.length > 0) { %>
          <div class="table-responsive">
            <table class="cse-table">
              <thead>
                <tr>
                  <th>Tx ID</th>
                  <th>Amount</th>
                  <th>Payment Method</th>
                  <th>Collected By</th>
                  <th>Date</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% contributions.forEach(c => { %>
                  <tr>
                    <td><span class="code-tag"><%= c.transactionReference %></span></td>
                    <td class="text-success fw-bold">₹<%= c.amount.toLocaleString('en-IN') %></td>
                    <td><span class="badge bg-dark border border-secondary"><%= c.paymentMethod %></span></td>
                    <td class="small text-secondary"><%= c.collectedByName %></td>
                    <td class="small text-secondary"><%= new Date(c.collectedAt).toLocaleDateString('en-IN') %></td>
                    <td>
                      <a href="/contributions/<%= c._id %>/receipt" class="btn btn-outline-info btn-sm py-0 px-2" style="font-size: 0.75rem;">
                        <i class="fa-solid fa-file-invoice"></i> Receipt
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-5 text-secondary">
            <i class="fa-solid fa-receipt fa-3x mb-3 opacity-25"></i>
            <p class="mb-0">No contribution payments have been recorded for this student.</p>
            <% if (student.year === '1st Year') { %>
              <p class="text-danger small mt-2">Note: 1st Year students are restricted from contributing.</p>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Login | CSE EventLedger' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100 py-4" style="background: radial-gradient(circle at center, #111827 0%, #080c14 100%);">
  <div class="container" style="max-width: 440px;">
    <div class="text-center mb-4">
      <div class="d-inline-flex p-3 rounded-4 bg-primary bg-opacity-10 border border-primary border-opacity-25 text-primary mb-3 shadow">
        <i class="fa-solid fa-code fa-2x"></i>
      </div>
      <h3 class="fw-bold text-white mb-1">CSE EventLedger</h3>
      <p class="text-secondary small mb-0">Teachers' Day 2026 Finance Management</p>
    </div>

    <div class="cse-card p-4 shadow-lg border-secondary border-opacity-25">
      <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom border-secondary border-opacity-25">
        <span class="small fw-semibold text-light"><i class="fa-solid fa-lock text-primary me-2"></i>Sign In</span>
        <span class="code-tag" style="font-size: 0.7rem;">AUTH_REQUIRED</span>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger d-flex align-items-center py-2 px-3 small mb-3 bg-danger bg-opacity-10 border-danger text-danger" role="alert">
          <i class="fa-solid fa-circle-exclamation me-2"></i>
          <div><%= error %></div>
        </div>
      <% } %>

      <form action="/auth/login" method="POST">
        <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '/dashboard' %>">

        <div class="mb-3">
          <label class="form-label small text-secondary fw-semibold">Email Address</label>
          <div class="input-group">
            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fa-solid fa-envelope"></i></span>
            <input type="email" name="email" class="form-control cse-input" placeholder="name@cse.edu" required autocomplete="email" autofocus>
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label small text-secondary fw-semibold">Password</label>
          <div class="input-group">
            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fa-solid fa-key"></i></span>
            <input type="password" name="password" class="form-control cse-input" placeholder="••••••••" required autocomplete="current-password">
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow d-flex align-items-center justify-content-center gap-2">
          <span>Authenticate & Enter</span>
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </form>

      <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 text-center">
        <div class="d-flex align-items-center justify-content-center gap-2 text-secondary" style="font-size: 0.75rem;">
          <i class="fa-solid fa-shield-halved text-success"></i>
          <span>Role-Based Access Control Active</span>
        </div>
        <p class="text-secondary mt-2 mb-0" style="font-size: 0.72rem;">
          No public registration. Accounts are authorized strictly by the CSE SuperAdministrator.
        </p>
      </div>
    </div>

    <!-- Credentials demo helper -->
    <div class="mt-3 p-3 rounded-3 bg-dark border border-secondary border-opacity-25 small text-secondary">
      <div class="d-flex align-items-center justify-content-between mb-1">
        <strong class="text-light" style="font-size: 0.75rem;">Demo Credentials</strong>
        <span class="badge bg-secondary" style="font-size: 0.65rem;">Environment</span>
      </div>
      <div class="font-monospace text-info" style="font-size: 0.72rem;">
        SuperAdmin: <%= typeof superAdminEmailHint !== 'undefined' ? superAdminEmailHint : 'superadmin@example.com' %> / SuperAdmin@2026!
      </div>
      <div class="font-monospace text-secondary" style="font-size: 0.72rem;">
        Volunteer Admin: rahul.volunteer@example.com / Password@123
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

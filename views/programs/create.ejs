<%- include('../partials/header') %>

<div class="page-header d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3 mb-4">
  <div>
    <a href="/programs" class="btn btn-light btn-sm mb-2"><i class="fa-solid fa-arrow-left me-1"></i>Back to Programs</a>
    <h4 class="page-title mb-1"><i class="fa-solid fa-calendar-plus me-2 text-primary"></i>Schedule New Program</h4>
    <p class="page-subtitle mb-0">Add any CSE department event (Teachers' Day, Hackathon, Freshers, Workshops, etc.) and publish its schedule</p>
  </div>
</div>

<div class="row justify-content-center">
  <div class="col-12 col-lg-9">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger py-2 small mb-4">
            <i class="fa-solid fa-circle-exclamation me-2"></i><%= error %>
          </div>
        <% } %>

        <form action="/programs" method="POST">
          
          <!-- Basic Info -->
          <div class="row g-3 mb-3">
            <div class="col-12 col-md-8">
              <label class="form-label fw-semibold">Program Title <span class="text-danger">*</span></label>
              <input type="text" name="title" class="form-control" placeholder="e.g. Teachers' Day Celebration 2026 / CodeSprint Hackathon" required value="<%= formData.title || '' %>">
            </div>

            <div class="col-12 col-md-4">
              <label class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
              <select name="category" class="form-select" required>
                <% categories.forEach(c => { %>
                  <option value="<%= c %>" <%= formData.category === c ? 'selected' : '' %>><%= c %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <!-- Date, Time, Venue -->
          <div class="row g-3 mb-3">
            <div class="col-12 col-md-4">
              <label class="form-label fw-semibold">Event Date <span class="text-danger">*</span></label>
              <input type="text" name="eventDate" class="form-control" placeholder="e.g. 3rd September 2026" required value="<%= formData.eventDate || '' %>">
            </div>

            <div class="col-12 col-md-4">
              <label class="form-label fw-semibold">Event Time <span class="text-danger">*</span></label>
              <input type="text" name="eventTime" class="form-control" placeholder="e.g. 10:30 AM - 04:30 PM" required value="<%= formData.eventTime || '' %>">
            </div>

            <div class="col-12 col-md-4">
              <label class="form-label fw-semibold">Venue / Hall <span class="text-danger">*</span></label>
              <input type="text" name="venue" class="form-control" placeholder="e.g. CSE Main Auditorium (Hall 302)" required value="<%= formData.venue || 'CSE Main Auditorium (Hall 302)' %>">
            </div>
          </div>

          <!-- Descriptions -->
          <div class="mb-3">
            <label class="form-label fw-semibold">Short Summary / Tagline</label>
            <input type="text" name="shortDescription" class="form-control" placeholder="A brief 1-line overview of the event..." value="<%= formData.shortDescription || '' %>">
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Full Event Description</label>
            <textarea name="description" rows="3" class="form-control" placeholder="Detailed description of the program, objectives, chief guests, special highlights..."><%= formData.description || '' %></textarea>
          </div>

          <!-- Status & Featured -->
          <div class="row g-3 mb-3">
            <div class="col-12 col-md-4">
              <label class="form-label fw-semibold">Program Status</label>
              <select name="status" class="form-select">
                <% statuses.forEach(s => { %>
                  <option value="<%= s %>" <%= formData.status === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-12 col-md-4">
              <label class="form-label fw-semibold">Student Registration</label>
              <select name="registrationStatus" class="form-select">
                <% regStatuses.forEach(rs => { %>
                  <option value="<%= rs %>" <%= formData.registrationStatus === rs ? 'selected' : '' %>><%= rs %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-12 col-md-4 d-flex align-items-center pt-md-4">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="isFeatured" value="true" id="featuredSwitch">
                <label class="form-check-label fw-semibold" for="featuredSwitch">Set as Featured Hero Event</label>
              </div>
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label fw-semibold">Tags (comma-separated)</label>
            <input type="text" name="tags" class="form-control" placeholder="e.g. 3rd Sep, celebration, faculty, coding, prizes" value="<%= formData.tags || '' %>">
          </div>

          <!-- Agenda / Timeline Builder -->
          <div class="border-top pt-3 mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <label class="form-label fw-bold mb-0"><i class="fa-solid fa-clock-rotate-left me-1 text-primary"></i>Program Itinerary / Agenda Slots</label>
              <button type="button" class="btn btn-outline-primary btn-sm" onclick="addAgendaRow()">
                <i class="fa-solid fa-plus me-1"></i>Add Agenda Slot
              </button>
            </div>
            <p class="text-muted small mb-3">Add time slots and activities. These will be dynamically displayed on the React website timeline.</p>

            <div id="agendaContainer" class="d-flex flex-column gap-2">
              <div class="row g-2 agenda-row align-items-center">
                <div class="col-3">
                  <input type="text" name="agendaTime[]" class="form-control form-control-sm font-monospace" placeholder="10:30 AM" value="10:30 AM">
                </div>
                <div class="col-5">
                  <input type="text" name="agendaActivity[]" class="form-control form-control-sm" placeholder="Activity Title / Event" value="Inauguration & Welcome Speech">
                </div>
                <div class="col-3">
                  <input type="text" name="agendaSpeaker[]" class="form-control form-control-sm" placeholder="Speaker / Performer (optional)">
                </div>
                <div class="col-1 text-center">
                  <button type="button" class="btn btn-link text-danger p-0" onclick="this.closest('.agenda-row').remove()"><i class="fa-solid fa-trash"></i></button>
                </div>
              </div>

              <div class="row g-2 agenda-row align-items-center">
                <div class="col-3">
                  <input type="text" name="agendaTime[]" class="form-control form-control-sm font-monospace" placeholder="11:30 AM" value="11:30 AM">
                </div>
                <div class="col-5">
                  <input type="text" name="agendaActivity[]" class="form-control form-control-sm" placeholder="Activity Title / Event" value="Cultural Performances & Tributes">
                </div>
                <div class="col-3">
                  <input type="text" name="agendaSpeaker[]" class="form-control form-control-sm" placeholder="Students">
                </div>
                <div class="col-1 text-center">
                  <button type="button" class="btn btn-link text-danger p-0" onclick="this.closest('.agenda-row').remove()"><i class="fa-solid fa-trash"></i></button>
                </div>
              </div>
            </div>
          </div>

          <!-- Submit -->
          <div class="d-flex gap-2 pt-3 border-top">
            <a href="/programs" class="btn btn-light flex-grow-1">Cancel</a>
            <button type="submit" class="btn btn-primary flex-grow-1 fw-semibold">
              <i class="fa-solid fa-calendar-check me-1"></i>Publish Program Schedule
            </button>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

<script>
function addAgendaRow() {
  const container = document.getElementById('agendaContainer');
  const div = document.createElement('div');
  div.className = 'row g-2 agenda-row align-items-center';
  div.innerHTML = `
    <div class="col-3">
      <input type="text" name="agendaTime[]" class="form-control form-control-sm font-monospace" placeholder="Time (e.g. 01:00 PM)">
    </div>
    <div class="col-5">
      <input type="text" name="agendaActivity[]" class="form-control form-control-sm" placeholder="Activity Title / Event">
    </div>
    <div class="col-3">
      <input type="text" name="agendaSpeaker[]" class="form-control form-control-sm" placeholder="Speaker / Performer (optional)">
    </div>
    <div class="col-1 text-center">
      <button type="button" class="btn btn-link text-danger p-0" onclick="this.closest('.agenda-row').remove()"><i class="fa-solid fa-trash"></i></button>
    </div>
  `;
  container.appendChild(div);
}
</script>

<%- include('../partials/footer') %>

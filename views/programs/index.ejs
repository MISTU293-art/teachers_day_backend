<%- include('../partials/header') %>

<div class="page-header d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3 mb-4">
  <div>
    <h4 class="page-title mb-1"><i class="fa-solid fa-calendar-check me-2 text-primary"></i>Department Programs & Events</h4>
    <p class="page-subtitle mb-0">Schedule and manage all CSE department celebrations, hackathons, seminars, and event itineraries</p>
  </div>
  <a href="/programs/create" class="btn btn-primary btn-sm fw-semibold">
    <i class="fa-solid fa-plus me-1"></i> Schedule Program
  </a>
</div>

<!-- Flash message -->
<% if (typeof query !== 'undefined' && query.msg) { %>
  <div class="alert alert-success alert-dismissible fade show py-2 small mb-3" role="alert">
    <i class="fa-solid fa-circle-check me-2"></i><%= query.msg %>
    <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (typeof query !== 'undefined' && query.error) { %>
  <div class="alert alert-danger alert-dismissible fade show py-2 small mb-3" role="alert">
    <i class="fa-solid fa-circle-exclamation me-2"></i><%= query.error %>
    <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
  <div class="col-12 col-sm-4">
    <div class="stat-card blue">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="text-muted small fw-semibold text-uppercase">Total Programs</div>
          <h3 class="fw-bold text-dark mb-0 mt-1"><%= counts.total %></h3>
          <span class="text-muted small" style="font-size: 0.75rem;">Department Events</span>
        </div>
        <div class="stat-icon">
          <i class="fa-solid fa-layer-group"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-4">
    <div class="stat-card green">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="text-muted small fw-semibold text-uppercase">Upcoming Schedules</div>
          <h3 class="fw-bold text-success mb-0 mt-1"><%= counts.upcoming %></h3>
          <span class="text-success small" style="font-size: 0.75rem;">Active on React Portal</span>
        </div>
        <div class="stat-icon">
          <i class="fa-solid fa-calendar-days"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-4">
    <div class="stat-card purple">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="text-muted small fw-semibold text-uppercase">Completed Events</div>
          <h3 class="fw-bold text-primary mb-0 mt-1"><%= counts.completed %></h3>
          <span class="text-muted small" style="font-size: 0.75rem;">Archived Events</span>
        </div>
        <div class="stat-icon">
          <i class="fa-solid fa-clock-rotate-left"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body py-3">
    <form action="/programs" method="GET" class="row g-2 align-items-end">
      <div class="col-12 col-md-4">
        <label class="form-label form-label-sm fw-semibold text-muted mb-1">Search</label>
        <div class="input-group input-group-sm">
          <span class="input-group-text"><i class="fa-solid fa-search"></i></span>
          <input type="text" name="search" class="form-control" placeholder="Search program title, venue, tag..." value="<%= query.search || '' %>">
        </div>
      </div>

      <div class="col-6 col-md-3">
        <label class="form-label form-label-sm fw-semibold text-muted mb-1">Category</label>
        <select name="category" class="form-select form-select-sm">
          <option value="">All Categories</option>
          <% categories.forEach(c => { %>
            <option value="<%= c %>" <%= query.category === c ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
      </div>

      <div class="col-6 col-md-3">
        <label class="form-label form-label-sm fw-semibold text-muted mb-1">Status</label>
        <select name="status" class="form-select form-select-sm">
          <option value="">All Statuses</option>
          <% statuses.forEach(s => { %>
            <option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>

      <div class="col-12 col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">
          <i class="fa-solid fa-filter me-1"></i>Filter
        </button>
        <% if (query.search || query.category || query.status) { %>
          <a href="/programs" class="btn btn-outline-secondary btn-sm" title="Clear">
            <i class="fa-solid fa-xmark"></i>
          </a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<!-- Programs Table (Desktop) / Cards (Mobile) -->
<div class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light border-bottom">
        <tr>
          <th class="ps-4">Program & Category</th>
          <th>Date & Time</th>
          <th>Venue</th>
          <th>Agenda Slots</th>
          <th>Status</th>
          <th class="pe-4">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (programs && programs.length > 0) { %>
          <% programs.forEach(p => { %>
            <tr>
              <td class="ps-4">
                <div class="d-flex align-items-center gap-2">
                  <% if (p.isFeatured) { %>
                    <span class="badge bg-warning text-dark border border-warning px-1.5 py-0.5" title="Featured Highlight">
                      <i class="fa-solid fa-star"></i>
                    </span>
                  <% } %>
                  <div>
                    <div class="fw-bold text-dark"><%= p.title %></div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.7rem;">
                      <%= p.category %>
                    </span>
                  </div>
                </div>
              </td>
              <td>
                <div class="small fw-semibold text-dark"><%= p.eventDate %></div>
                <div class="text-muted small" style="font-size: 0.72rem;"><i class="fa-solid fa-clock me-1"></i><%= p.eventTime %></div>
              </td>
              <td>
                <div class="small text-dark text-truncate" style="max-width: 220px;"><i class="fa-solid fa-location-dot me-1 text-danger"></i><%= p.venue %></div>
              </td>
              <td>
                <span class="badge bg-secondary-subtle text-secondary border">
                  <%= (p.agenda && p.agenda.length > 0) ? `${p.agenda.length} items` : 'No agenda' %>
                </span>
              </td>
              <td>
                <% if (p.status === 'Upcoming') { %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="fa-solid fa-circle-check me-1"></i>Upcoming</span>
                <% } else if (p.status === 'Ongoing') { %>
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="fa-solid fa-play me-1"></i>Ongoing</span>
                <% } else if (p.status === 'Completed') { %>
                  <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Completed</span>
                <% } else { %>
                  <span class="badge bg-warning-subtle text-warning border border-warning-subtle"><%= p.status %></span>
                <% } %>
              </td>
              <td class="pe-4">
                <div class="d-flex align-items-center gap-1">
                  <a href="/programs/<%= p._id %>/edit" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.75rem;" title="Edit Program">
                    <i class="fa-solid fa-pen-to-square"></i> Edit
                  </a>
                  <% if (currentUser && currentUser.role === 'superadmin') { %>
                    <form action="/programs/<%= p._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this program schedule permanently?')">
                      <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size: 0.75rem;" title="Delete">
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" class="text-center text-muted py-5">
              <i class="fa-solid fa-calendar-xmark fa-3x mb-3 opacity-50 d-block"></i>
              No department programs scheduled yet.
              <div class="mt-3">
                <a href="/programs/create" class="btn btn-primary btn-sm fw-semibold">
                  <i class="fa-solid fa-plus me-1"></i>Schedule First Program
                </a>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/pagination') %>
<%- include('../partials/footer') %>

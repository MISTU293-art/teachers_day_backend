<%- include('../partials/header') %>

<div class="container" style="max-width: 550px;">
  <!-- Action Bar -->
  <div class="d-flex align-items-center justify-content-between mb-4 no-print">
    <a href="/contributions" class="btn btn-outline-secondary btn-sm">
      <i class="fa-solid fa-arrow-left me-1"></i> Back to Ledger
    </a>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-info btn-sm fw-semibold">
        <i class="fa-solid fa-print me-1"></i> Print Receipt
      </button>
      <a href="/contributions/<%= contribution._id %>/receipt/pdf" target="_blank" class="btn btn-primary btn-sm fw-semibold">
        <i class="fa-solid fa-file-pdf me-1"></i> Download PDF
      </a>
    </div>
  </div>

  <!-- Receipt Card -->
  <div class="cse-card p-4 shadow-lg border-primary border-opacity-50" style="background-color: #0d1322;">
    <!-- Receipt Header -->
    <div class="text-center pb-3 border-bottom border-secondary border-opacity-50">
      <div class="d-inline-flex p-2 rounded-circle bg-primary bg-opacity-10 text-primary mb-2">
        <i class="fa-solid fa-code fa-lg"></i>
      </div>
      <h5 class="fw-bold text-white mb-0">DEPARTMENT OF COMPUTER SCIENCE & ENGINEERING</h5>
      <p class="text-info small fw-semibold mb-1">TEACHERS' DAY CELEBRATION 2026</p>
      <span class="badge bg-dark border border-secondary text-secondary" style="font-size: 0.72rem;">OFFICIAL CONTRIBUTION RECEIPT</span>
    </div>

    <!-- Transaction Code & Date -->
    <div class="d-flex justify-content-between align-items-center my-3 py-2 px-3 rounded bg-black border border-secondary border-opacity-25">
      <div>
        <span class="text-secondary small d-block">Transaction ID:</span>
        <span class="code-tag text-warning fw-bold"><%= contribution.transactionReference %></span>
      </div>
      <div class="text-end">
        <span class="text-secondary small d-block">Date & Time:</span>
        <span class="text-light small font-monospace"><%= new Date(contribution.collectedAt).toLocaleString('en-IN') %></span>
      </div>
    </div>

    <!-- Student Metadata -->
    <div class="my-3">
      <div class="row g-2 small">
        <div class="col-5 text-secondary">Student Name:</div>
        <div class="col-7 text-white fw-bold"><%= contribution.student ? contribution.student.name : 'Unknown' %></div>

        <div class="col-5 text-secondary">Roll Number:</div>
        <div class="col-7 text-white font-monospace"><%= contribution.student ? contribution.student.rollNumber : 'N/A' %></div>

        <div class="col-5 text-secondary">Reg. Number:</div>
        <div class="col-7 text-white font-monospace"><%= contribution.student ? contribution.student.registrationNumber : 'N/A' %></div>

        <div class="col-5 text-secondary">Year & Dept:</div>
        <div class="col-7 text-white"><%= contribution.student ? contribution.student.year : '' %> - <%= contribution.student ? contribution.student.department : 'CSE' %></div>
      </div>
    </div>

    <!-- Amount Block -->
    <div class="p-3 my-3 rounded bg-primary bg-opacity-10 border border-primary border-opacity-25 text-center">
      <span class="text-info small fw-semibold text-uppercase d-block">Amount Contributed</span>
      <h2 class="fw-bold text-white mb-0 my-1">₹<%= (contribution.amount || 0).toLocaleString('en-IN') %></h2>
      <span class="badge bg-primary text-uppercase" style="font-size: 0.7rem;">Payment Method: <%= contribution.paymentMethod %></span>
    </div>

    <!-- Collector Info -->
    <div class="small pt-2 border-top border-secondary border-opacity-25">
      <div class="row g-1">
        <div class="col-5 text-secondary">Collected By:</div>
        <div class="col-7 text-light fw-semibold"><%= contribution.collectedByName %></div>

        <% if (contribution.notes) { %>
          <div class="col-5 text-secondary">Notes:</div>
          <div class="col-7 text-secondary fst-italic"><%= contribution.notes %></div>
        <% } %>
      </div>
    </div>

    <!-- Seal / Verification -->
    <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 text-center">
      <div class="d-inline-flex align-items-center gap-1 text-success fw-bold small">
        <i class="fa-solid fa-circle-check"></i>
        <span>AUTHENTICATED TRANSACTION</span>
      </div>
      <p class="text-secondary mt-1 mb-0" style="font-size: 0.7rem;">
        Thank you for your generous contribution to Teachers' Day 2026!
      </p>
      <span class="text-secondary font-monospace" style="font-size: 0.62rem;">Auth Token: <%= contribution._id %></span>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

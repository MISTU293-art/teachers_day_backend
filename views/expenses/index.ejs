<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
  <div>
    <h4 class="fw-bold text-black mb-1">Event Expense Management</h4>
    <p class="text-secondary small mb-0">Record vendor bills, stage decor, food, and gifts with SuperAdmin approval</p>
  </div>
  <div class="d-flex align-items-center gap-2">
    <a href="/reports/export/expenses/excel" class="btn btn-outline-success btn-sm">
      <i class="fa-solid fa-file-excel me-1"></i> Export Expenses
    </a>
    <button class="btn btn-primary btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
      <i class="fa-solid fa-plus me-1"></i> Add Expense
    </button>
  </div>
</div>

<!-- Expense Stat Cards -->
<div class="row g-3 mb-4">
  <div class="col-12 col-md-4">
    <div class="cse-card stat-card green p-3 h-100">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <span class="text-secondary small fw-semibold text-uppercase">Approved Expenditure</span>
          <h3 class="fw-bold text-success mb-0 mt-1">₹<%= totals.approvedTotal.toLocaleString('en-IN') %></h3>
          <span class="text-success small" style="font-size: 0.75rem;">Official deduction from pool</span>
        </div>
        <div class="stat-icon">
          <i class="fa-solid fa-circle-check"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-md-4">
    <div class="cse-card stat-card yellow p-3 h-100">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <span class="text-secondary small fw-semibold text-uppercase">Pending Review</span>
          <h3 class="fw-bold text-warning mb-0 mt-1">₹<%= totals.pendingTotal.toLocaleString('en-IN') %></h3>
          <span class="text-warning small" style="font-size: 0.75rem;">Awaiting SuperAdmin approval</span>
        </div>
        <div class="stat-icon">
          <i class="fa-solid fa-clock"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-md-4">
    <div class="cse-card stat-card red p-3 h-100">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <span class="text-secondary small fw-semibold text-uppercase">Rejected Bills</span>
          <h3 class="fw-bold text-danger mb-0 mt-1">₹<%= totals.rejectedTotal.toLocaleString('en-IN') %></h3>
          <span class="text-secondary small" style="font-size: 0.75rem;">Excluded from balance</span>
        </div>
        <div class="stat-icon">
          <i class="fa-solid fa-ban"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Filters -->
<div class="cse-card p-3 mb-4">
  <form action="/expenses" method="GET" class="row g-2 align-items-center">
    <div class="col-12 col-md-4">
      <div class="input-group input-group-sm">
        <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fa-solid fa-search"></i></span>
        <input type="text" name="search" class="form-control cse-input" placeholder="Search title, vendor..." value="<%= query.search || '' %>">
      </div>
    </div>

    <div class="col-6 col-md-3">
      <select name="category" class="form-select form-select-sm cse-input">
        <option value="">All Categories</option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat %>" <%= query.category === cat ? 'selected' : '' %>><%= cat %></option>
        <% }) %>
      </select>
    </div>

    <div class="col-6 col-md-3">
      <select name="status" class="form-select form-select-sm cse-input">
        <option value="">All Statuses</option>
        <% statuses.forEach(st => { %>
          <option value="<%= st %>" <%= query.status === st ? 'selected' : '' %>><%= st.toUpperCase() %></option>
        <% }) %>
      </select>
    </div>

    <div class="col-12 col-md-2 d-flex gap-2">
      <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">
        <i class="fa-solid fa-filter me-1"></i> Filter
      </button>
      <% if (query.search || query.category || query.status) { %>
        <a href="/expenses" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
          <i class="fa-solid fa-xmark"></i>
        </a>
      <% } %>
    </div>
  </form>
</div>

<!-- Expenses Table -->
<div class="cse-table-wrapper">
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>Expense Title</th>
          <th>Category</th>
          <th>Amount</th>
          <th>Paid To</th>
          <th>Method</th>
          <th>Added By</th>
          <th>Status</th>
          <th>Date</th>
          <% if (currentUser && currentUser.role === 'superadmin') { %>
            <th>Actions</th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% if (expenses && expenses.length > 0) { %>
          <% expenses.forEach(exp => { %>
            <tr>
              <td>
                <span class="fw-semibold text-black d-block"><%= exp.title %></span>
                <% if (exp.description) { %>
                  <span class="text-secondary small" style="font-size: 0.72rem;"><%= exp.description %></span>
                <% } %>
              </td>
              <td><span class="badge bg-secondary bg-opacity-50"><%= exp.category %></span></td>
              <td class="text-danger fw-bold">₹<%= exp.amount.toLocaleString('en-IN') %></td>
              <td class="text-black small"><%= exp.paidTo %></td>
              <td><span class="badge bg-dark border border-secondary text-secondary"><%= exp.paymentMethod %></span></td>
              <td class="text-secondary small"><%= exp.addedBy ? exp.addedBy.name : 'System' %></td>
              <td>
                <span class="badge-cse <%= exp.status %>"><%= exp.status.toUpperCase() %></span>
                <% if (exp.rejectionReason) { %>
                  <div class="text-danger small" style="font-size: 0.68rem;"><%= exp.rejectionReason %></div>
                <% } %>
              </td>
              <td class="text-secondary small font-monospace"><%= new Date(exp.expenseDate).toLocaleDateString('en-IN') %></td>
              
              <% if (currentUser && currentUser.role === 'superadmin') { %>
                <td>
                  <% if (exp.status === 'pending') { %>
                    <div class="d-flex gap-1 visible">
                      <form action="/expenses/<%= exp._id %>/approve" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-success btn-sm py-0 px-2" style="font-size: 0.75rem;" title="Approve Expense">
                          <i class="fa-solid fa-check"></i>
                        </button>
                      </form>
                      <button type="button" class="btn btn-danger btn-sm py-0 px-2" style="font-size: 0.75rem;" title="Reject Expense" data-bs-toggle="modal" data-bs-target="#rejectExpenseModal_<%= exp._id %>">
                        <i class="fa-solid fa-xmark"></i>
                      </button>
                    </div>

                    <!-- Reject Modal -->
                    <div class="modal fade" id="rejectExpenseModal_<%= exp._id %>" tabindex="-1">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content bg-dark border-secondary">
                          <form action="/expenses/<%= exp._id %>/reject" method="POST">
                            <div class="modal-header border-secondary">
                              <h6 class="modal-title text-danger"><i class="fa-solid fa-ban me-2"></i>Reject Expense</h6>
                              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                              <p class="text-light small">Are you sure you want to reject this ₹<%= exp.amount %> expense for "<%= exp.title %>"?</p>
                              <div class="mb-3">
                                <label class="form-label small text-secondary">Rejection Reason</label>
                                <input type="text" name="reason" class="form-control cse-input" placeholder="e.g. Incomplete bill receipt" required>
                              </div>
                            </div>
                            <div class="modal-footer border-secondary">
                              <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                              <button type="submit" class="btn btn-danger btn-sm">Confirm Rejection</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
                  <% } else { %>
                    <span class="text-secondary small">-</span>
                  <% } %>
                </td>
              <% } %>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="<%= currentUser && currentUser.role === 'superadmin' ? 9 : 8 %>" class="text-center text-secondary py-4">No expenses found matching the criteria.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/pagination') %>

<!-- Add Expense Modal -->
<div class="modal fade" id="addExpenseModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content bg-dark border-secondary shadow-lg">
      <form action="/expenses" method="POST">
        <div class="modal-header border-secondary">
          <h5 class="modal-title text-light"><i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i>Record Event Expense</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body text-light">
          <div class="row g-3">
            <div class="col-12 col-md-8">
              <label class="form-label small text-secondary fw-semibold">Expense Title *</label>
              <input type="text" name="title" class="form-control cse-input" placeholder="e.g. Stage Sound System Rental" required>
            </div>

            <div class="col-12 col-md-4">
              <label class="form-label small text-secondary fw-semibold">Category *</label>
              <select name="category" class="form-select cse-input" required>
                <option value="">Select Category</option>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat %>"><%= cat %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label small text-secondary fw-semibold">Amount (INR) *</label>
              <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-danger fw-bold">₹</span>
                <input type="number" name="amount" min="1" step="any" class="form-control cse-input" placeholder="e.g. 2500" required>
              </div>
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label small text-secondary fw-semibold">Paid To (Vendor / Person) *</label>
              <input type="text" name="paidTo" class="form-control cse-input" placeholder="e.g. City Sound & Lights" required>
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label small text-secondary fw-semibold">Payment Method</label>
              <select name="paymentMethod" class="form-select cse-input">
                <% paymentMethods.forEach(pm => { %>
                  <option value="<%= pm %>"><%= pm %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label small text-secondary fw-semibold">Expense Date</label>
              <input type="date" name="expenseDate" class="form-control cse-input">
            </div>

            <div class="col-12">
              <label class="form-label small text-secondary fw-semibold">Description / Notes</label>
              <textarea name="description" rows="2" class="form-control cse-input" placeholder="Details about items purchased, invoice number, etc."></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary fw-semibold px-4">Submit Expense</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

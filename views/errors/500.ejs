<%- include('../partials/header') %>

<div class="container text-center py-5" style="max-width: 600px;">
  <div class="cse-card p-5 border-danger border-opacity-50">
    <div class="d-inline-flex p-3 rounded-circle bg-danger bg-opacity-10 text-danger mb-3">
      <i class="fa-solid fa-bug-slash fa-3x"></i>
    </div>
    <h2 class="fw-bold text-white mb-2">500 - Internal Server Error</h2>
    <p class="text-secondary mb-4"><%= typeof message !== 'undefined' ? message : 'An unexpected exception occurred while processing this transaction.' %></p>
    <a href="/dashboard" class="btn btn-primary btn-sm">
      <i class="fa-solid fa-house me-1"></i> Return to Dashboard
    </a>
  </div>
</div>

<%- include('../partials/footer') %>

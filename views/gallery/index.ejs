<%- include('../partials/header') %>

<div class="page-header d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3 mb-4">
  <div>
    <h4 class="page-title mb-1"><i class="fa-solid fa-images me-2 text-primary"></i>Event Gallery</h4>
    <p class="page-subtitle mb-0">Manage event photos hosted on ImageKit.io CDN and displayed on the public celebration site</p>
  </div>
  <a href="/gallery/upload" class="btn btn-primary btn-sm fw-semibold">
    <i class="fa-solid fa-cloud-arrow-up me-1"></i> Upload Photos
  </a>
</div>

<!-- Flash messages -->
<% if (typeof query !== 'undefined' && query.msg) { %>
  <div class="alert alert-success alert-dismissible fade show py-2 small mb-3" role="alert">
    <i class="fa-solid fa-circle-check me-2"></i><%= query.msg %>
    <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (typeof query !== 'undefined' && query.error) { %>
  <div class="alert alert-danger alert-dismissible fade show py-2 small mb-3" role="alert">
    <i class="fa-solid fa-circle-exclamation me-2"></i><%= query.error %>
    <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (images && images.length > 0) { %>
  <div class="row g-3 mb-4">
    <% images.forEach(img => { %>
      <div class="col-12 col-sm-6 col-md-4 col-lg-3">
        <div class="card h-100 border-0 shadow-sm overflow-hidden position-relative group">
          <div style="height: 190px; overflow: hidden; background: #0f172a;" class="d-flex align-items-center justify-content-center">
            <img src="<%= img.thumbnailUrl || img.imageUrl %>" alt="<%= img.title %>" class="w-100 h-100 object-fit-cover" loading="lazy" style="transition: transform 0.3s ease;">
          </div>
          <div class="card-body p-3 d-flex flex-column justify-content-between">
            <div>
              <h6 class="fw-bold text-dark mb-1 text-truncate" title="<%= img.title %>"><%= img.title %></h6>
              <% if (img.description) { %>
                <p class="text-muted small mb-2 text-truncate" style="font-size: 0.75rem;"><%= img.description %></p>
              <% } %>
              <div class="d-flex align-items-center justify-content-between text-muted" style="font-size: 0.72rem;">
                <span><i class="fa-solid fa-user me-1"></i><%= img.uploadedBy ? img.uploadedBy.name : 'Admin' %></span>
                <span><%= new Date(img.createdAt).toLocaleDateString('en-IN') %></span>
              </div>
            </div>

            <div class="d-flex align-items-center justify-content-between pt-2 mt-2 border-top">
              <a href="<%= img.imageUrl %>" target="_blank" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.75rem;" title="Open full resolution">
                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>View
              </a>
              <% if (currentUser && currentUser.role === 'superadmin') { %>
                <form action="/gallery/<%= img._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this image permanently from ImageKit and gallery?')">
                  <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size: 0.75rem;" title="Delete image">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <%- include('../partials/pagination') %>

<% } else { %>
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
      <i class="fa-solid fa-images fa-3x text-muted mb-3 opacity-50"></i>
      <h5 class="text-dark fw-bold">No photos uploaded yet</h5>
      <p class="text-muted small mb-4">Upload celebration photos, memories, and stage moments to ImageKit CDN.</p>
      <a href="/gallery/upload" class="btn btn-primary fw-semibold">
        <i class="fa-solid fa-cloud-arrow-up me-1"></i>Upload First Photo
      </a>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>

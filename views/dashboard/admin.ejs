<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
  <div>
    <h4 class="fw-bold text-black mb-1">Volunteer Collection Terminal</h4>
    <p class="text-secondary small mb-0">Welcome, <strong><%= currentUser.name %></strong> • CSE Event Volunteer Portal</p>
  </div>
  <div>
    <a href="/contributions/collect" class="btn btn-warning fw-bold shadow">
      <i class="fa-solid fa-plus me-1"></i> Collect Student Money
    </a>
  </div>
</div>

<!-- Volunteer Stats Cards -->
<div class="row g-3 mb-4">
  <div class="col-12 col-md-4">
    <div class="cse-card stat-card blue p-3 h-100">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <span class="text-black small fw-semibold text-uppercase">My Collections</span>
          <h3 class="fw-bold text-black mb-0 mt-1">₹<%= stats.myCollectionsTotal.toLocaleString('en-IN') %></h3>
          <span class="text-info small" style="font-size: 0.75rem;"><%= stats.myTransactionsCount %> payments collected by you</span>
        </div>
        <div class="stat-icon">
          <i class="fa-solid fa-user-check"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-md-4">
    <div class="cse-card stat-card green p-3 h-100">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <span class="text-secondary small fw-semibold text-uppercase">Total Event Pool</span>
          <h3 class="fw-bold text-success mb-0 mt-1">₹<%= stats.totalCollected.toLocaleString('en-IN') %></h3>
          <span class="text-secondary small" style="font-size: 0.75rem;"><%= stats.totalTransactions %> total contributions</span>
        </div>
        <div class="stat-icon">
          <i class="fa-solid fa-vault"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-md-4">
    <div class="cse-card stat-card yellow p-3 h-100">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <span class="text-secondary small fw-semibold text-uppercase">Eligible Contributors</span>
          <h3 class="fw-bold text-warning mb-0 mt-1"><%= stats.paidStudents %> / <%= stats.eligibleStudents %></h3>
          <span class="text-secondary small" style="font-size: 0.75rem;">2nd, 3rd, 4th Year Students</span>
        </div>
        <div class="stat-icon">
          <i class="fa-solid fa-graduation-cap"></i>
        </div>
      </div>
</div>

<!-- Event & Portal Quick Links -->
<div class="row g-3 mb-4">
  <div class="col-12 col-md-4">
    <a href="/programs" class="text-decoration-none">
      <div class="cse-card p-3 d-flex align-items-center justify-content-between border-start border-primary border-4 h-100 hover-shadow transition-all">
        <div class="d-flex align-items-center gap-3">
          <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-3">
            <i class="fa-solid fa-calendar-check fa-lg"></i>
          </div>
          <div>
            <h5 class="fw-bold text-dark mb-0"><%= stats.totalPrograms || 0 %></h5>
            <span class="text-secondary small" style="font-size: 0.75rem;">Department Programs</span>
          </div>
        </div>
        <span class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.72rem;">View</span>
      </div>
    </a>
  </div>

  <div class="col-12 col-md-4">
    <a href="/gallery/upload" class="text-decoration-none">
      <div class="cse-card p-3 d-flex align-items-center justify-content-between border-start border-info border-4 h-100 hover-shadow transition-all">
        <div class="d-flex align-items-center gap-3">
          <div class="bg-info bg-opacity-10 text-info p-2 rounded-3">
            <i class="fa-solid fa-cloud-arrow-up fa-lg"></i>
          </div>
          <div>
            <h5 class="fw-bold text-dark mb-0"><%= stats.totalGalleryPhotos || 0 %></h5>
            <span class="text-secondary small" style="font-size: 0.75rem;">Upload Event Photos</span>
          </div>
        </div>
        <span class="btn btn-outline-info btn-sm py-0 px-2" style="font-size: 0.72rem;">Upload</span>
      </div>
    </a>
  </div>

  <div class="col-12 col-md-4">
    <a href="/participations" class="text-decoration-none">
      <div class="cse-card p-3 d-flex align-items-center justify-content-between border-start border-warning border-4 h-100 hover-shadow transition-all">
        <div class="d-flex align-items-center gap-3">
          <div class="bg-warning bg-opacity-10 text-warning p-2 rounded-3">
            <i class="fa-solid fa-microphone-lines fa-lg"></i>
          </div>
          <div>
            <h5 class="fw-bold text-dark mb-0"><%= stats.totalParticipations || 0 %></h5>
            <span class="text-secondary small" style="font-size: 0.75rem;">Performance Submissions</span>
          </div>
        </div>
        <span class="btn btn-outline-warning btn-sm py-0 px-2" style="font-size: 0.72rem;">Review</span>
      </div>
    </a>
  </div>
</div>

<!-- Quick Collection CTA Banner -->
<div class="cse-card p-4 mb-4 border-warning border-opacity-25" style="background: linear-gradient(90deg, #1e1b4b 0%, #172554 100%);">
  <div class="row align-items-center">
    <div class="col-12 col-md-8">
      <h5 class="fw-bold text-white mb-1"><i class="fa-solid fa-qrcode text-warning me-2"></i>Collect Student Contribution Now</h5>
      <p class="text-light text-opacity-75 small mb-md-0">
        Search any CSE student by name or roll number. First-year students are automatically blocked by the system.
      </p>
    </div>
    <div class="col-12 col-md-4 text-md-end">
      <a href="/contributions/collect" class="btn btn-warning btn-lg fw-bold shadow-sm">
        <i class="fa-solid fa-arrow-right me-1"></i> Open Terminal
      </a>
    </div>
  </div>
</div>


<%- include('../partials/footer') %>
